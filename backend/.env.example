# All settings are optional; PaperPilot runs with none of them set.
# Copy to .env and fill in what you have.

# Identifies this client to every upstream API (all three ask for it).
PAPERPILOT_USER_AGENT="PaperPilot/0.1 (mailto:you@example.com)"

# NCBI raises the rate limit from 3 to 10 requests/second with a key.
# Free: https://account.ncbi.nlm.nih.gov/settings/
PAPERPILOT_PUBMED_API_KEY=
PAPERPILOT_PUBMED_EMAIL=

# Supplying a mailto puts requests in Crossref's faster "polite" pool.
PAPERPILOT_CROSSREF_MAILTO=

PAPERPILOT_LOG_LEVEL=INFO

# --- Stage 4: AI summarization -----------------------------------------
# Without a key the app still runs: summaries fall back to extractive
# sentences taken verbatim from the abstract, labelled as such.
# Free tier: https://console.mistral.ai/
PAPERPILOT_LLM_PROVIDER=mistral
PAPERPILOT_MISTRAL_API_KEY=
PAPERPILOT_SUMMARY_MODEL=mistral-small-latest

# Set to a lower value to reject summaries that stray further from the
# abstract's vocabulary. Measured false-positive rate at 0.55 is 0.7%.
PAPERPILOT_GROUNDING_MIN_OVERLAP=0.55

# SQLite file for cached summaries. Empty disables caching.
PAPERPILOT_SUMMARY_CACHE_PATH=data/paperpilot.db
