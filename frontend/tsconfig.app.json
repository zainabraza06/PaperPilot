{
  "compilerOptions": {
    /* Required, not optional. This is a *referenced* project (see
       tsconfig.json), and without `composite` the build mode does not know
       it is a check-only project: it looks for emitted outputs like
       `src/App.js`, never finds them because `noEmit` is set, concludes the
       project is stale, and rebuilds everything on every run. The
       tsBuildInfoFile below is written but never trusted, so the
       incremental cache is silently dead:

         $ tsc -b --verbose        # before
         Project 'tsconfig.app.json' is out of date because output file
         'src/App.js' does not exist

         $ tsc -b --verbose        # after
         Project 'tsconfig.app.json' is up to date because newest input
         'src/App.tsx' is older than output '...tsconfig.app.tsbuildinfo'

       Nothing failed, which is why it survived: the only symptom was every
       build paying full cost. */
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    /* Vite transpiles with esbuild, one file at a time, so anything that
       needs whole-program knowledge to erase correctly is a runtime bug
       waiting to happen. `verbatimModuleSyntax` covers the import/export
       half of this; `isolatedModules` is what covers the rest. */
    "isolatedModules": true,

    /* Strict mode, in full. The brief asks for it, and the parts beyond
       `strict` are the ones that actually catch bugs in this codebase:
       the API returns optional fields everywhere, so indexed access and
       exact-optional checking are what stop `paper.score.combined` from
       compiling when `score` may be null. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "useUnknownInCatchVariables": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
